# Copy to .env (local dev) — for GitHub Actions, add these as repo Secrets.
#
# Collect phase (deep-dive generation) — free open models:
#   Groq:        https://console.groq.com/keys
#   OpenRouter:  https://openrouter.ai/settings/keys
# Check phase (search-grounding verification):
#   Gemini:      https://aistudio.google.com/apikey
#
# Missing keys = provider auto-disabled (pipeline runs with whatever is set)
GROQ_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2
